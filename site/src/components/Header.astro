---
import { routes, toLocale, type RouteKey } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  route: RouteKey | null;
}

const { route } = Astro.props;
const lang = toLocale(Astro.currentLocale);
const t = ui[lang];
const other = t.switchLang as 'fr' | 'en';
const switchHref = route ? routes[route][other] : routes.home[other];
const items = (['mobilis', 'approach', 'about'] as const).map((key) => ({
  key,
  href: routes[key][lang],
  label: t[key],
}));
---

<header class="site-header" data-site-header>
  <div class="bar">
    <a class="brand" href={routes.home[lang]} aria-label={t.home}>
      <svg aria-hidden="true" width="28" height="28" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="var(--accent-strong)"></circle><path d="M10 22V10l12 12V10" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span>Neura Mobilis</span>
    </a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="open-icon" d="M4 7h16M4 12h16M4 17h16"></path><path class="close-icon" d="M6 6l12 12M18 6 6 18"></path></svg>
      {t.menu}
    </button>
    <nav id="site-menu" aria-label={t.navLabel}>
      <ul class="links">
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={route === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="tools">
        <li class="langs">
          <span aria-hidden="true">{lang.toUpperCase()}</span>
          <a href={switchHref} hreflang={other} lang={other}>{other.toUpperCase()}<span class="visually-hidden"> – {t.switchLabel}</span></a>
        </li>
        <li>
          <button type="button" class="theme" aria-pressed="false" aria-label={t.darkTheme} title={t.darkTheme} hidden data-theme-toggle>
            <svg class="moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
            <svg class="sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
        </li>
        <li>
          <a class="button" href={routes.tester[lang]} aria-current={route === 'tester' ? 'page' : undefined}>
            {t.tester}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  if (header && menuBtn) {
    const setOpen = (open: boolean) => {
      header.dataset.menu = open ? 'open' : 'closed';
      menuBtn.setAttribute('aria-expanded', String(open));
    };
    setOpen(false);
    menuBtn.addEventListener('click', () => setOpen(header.dataset.menu !== 'open'));
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.dataset.menu === 'open') {
        setOpen(false);
        menuBtn.focus();
      }
    });
  }

  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (btn) {
    const root = document.documentElement;
    const media = matchMedia('(prefers-color-scheme: dark)');
    const current = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');
    const render = () => btn.setAttribute('aria-pressed', String(current() === 'dark'));
    btn.hidden = false;
    render();
    media.addEventListener('change', render);
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      const system = media.matches ? 'dark' : 'light';
      // Choosing the system theme drops the override, so the site follows the system again.
      try {
        if (next === system) localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch {}
      if (next === system) delete root.dataset.theme;
      else root.dataset.theme = next;
      render();
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 5;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
  }
  .bar {
    max-width: var(--wide);
    margin: 0 auto;
    padding: 0.75rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  @media (min-width: 52rem) {
    .site-header {
      position: sticky;
      top: 0;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    color: var(--ink);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.75rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
  }
  nav a:not(.button) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  nav a:not(.button):hover,
  nav a[aria-current='page']:not(.button) {
    border-bottom-color: var(--accent);
  }
  nav a[aria-current='page']:not(.button) {
    font-weight: 600;
  }
  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.3rem 1rem 0.3rem 0.8rem;
    border-radius: 999px;
    border: 1.5px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .menu-toggle .close-icon,
  [data-menu='open'] .menu-toggle .open-icon {
    display: none;
  }
  [data-menu='open'] .menu-toggle .close-icon {
    display: inline;
  }
  /* Below this width the links sit behind the Menu button; without JS they stay visible. */
  @media (max-width: 59.99rem) {
    [data-menu] .menu-toggle {
      display: inline-flex;
    }
    [data-menu='closed'] nav {
      display: none;
    }
    [data-menu] nav {
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      padding-block: 0.25rem 0.75rem;
    }
    [data-menu] .links {
      flex-direction: column;
      align-items: stretch;
    }
    [data-menu] .links li {
      max-width: none;
      border-bottom: 1px solid var(--line);
    }
    [data-menu] .tools {
      padding-top: 0.75rem;
    }
  }
  .langs {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .langs > span {
    padding-inline: 0.35rem;
  }
  .langs > span::after {
    content: '·';
    margin-left: 0.5rem;
    color: var(--ink-soft);
    font-weight: 400;
  }
  .langs a {
    justify-content: center;
    min-width: 44px;
    color: var(--ink-soft);
    font-weight: 400;
  }
  .langs a:hover {
    color: var(--ink);
  }
  .theme {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.2s var(--ease);
  }
  .theme:hover {
    border-color: var(--ink);
  }
  .theme[hidden],
  .theme[aria-pressed='true'] .moon,
  .theme[aria-pressed='false'] .sun {
    display: none;
  }
</style>

---
interface Props {
  name: 'mic' | 'speaker' | 'lock' | 'arrow';
}
const { name } = Astro.props;
---

<svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'mic' && <><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8.5 21h7" /></>}
  {name === 'speaker' && <><path d="M11 5 6 9H3v6h3l5 4z" /><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" /></>}
  {name === 'lock' && <><rect x="6" y="2.5" width="12" height="19" rx="2.5" /><rect x="9" y="11" width="6" height="5" rx="1" /><path d="M10 11V9.5a2 2 0 0 1 4 0V11" /></>}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>

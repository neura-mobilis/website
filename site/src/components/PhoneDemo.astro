---
import { toLocale } from '../i18n/routes';
import { demo } from '../i18n/demo';

const lang = toLocale(Astro.currentLocale);
const t = demo[lang];
const data = JSON.stringify({ exchanges: t.exchanges, listening: t.listening, talk: t.talk, you: t.you, voiceLang: t.voiceLang });
---

<figure class="demo" data-phone-demo data-strings={data}>
  <div class="halo" aria-hidden="true"></div>
  <div class="phone" role="group" aria-label={t.label}>
    <div class="screen">
      <div class="status" aria-hidden="true">
        <span>{t.statusTime}</span>
        <svg width="54" height="12" viewBox="0 0 54 12"><path d="M2 10h2v-2H2zm4 0h2V7H6zm4 0h2V5h-2zm4 0h2V3h-2z" fill="currentColor"></path><rect x="30" y="2" width="20" height="9" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.4"></rect><rect x="32" y="4" width="12" height="5" rx="1" fill="currentColor"></rect></svg>
      </div>
      <div class="toplinks" aria-hidden="true">
        <span>{t.reactivate}</span>
        <span>{t.settings}</span>
      </div>
      <div class="log" role="log" aria-live="polite">
        <p class="idle">{t.idle}</p>
      </div>
      <div class="talk-zone">
        <span class="ring r1" aria-hidden="true"></span>
        <span class="ring r2" aria-hidden="true"></span>
        <span class="ring r3" aria-hidden="true"></span>
        <button type="button" class="talk"><span class="talk-label">{t.talk}</span></button>
      </div>
    </div>
  </div>
  <figcaption>
    <span>{t.caption}</span>
    <button type="button" class="sound" aria-pressed="false" hidden>
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H3v6h3l5 4z"></path><path class="wave" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"></path></svg>
      {t.sound}
    </button>
  </figcaption>
</figure>

<script>
  type Exchange = { ask: string; answer: string };
  type Strings = { exchanges: Exchange[]; listening: string; talk: string; you: string; voiceLang: string };

  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce.matches ? Math.min(ms, 250) : ms));

  for (const root of document.querySelectorAll<HTMLElement>('[data-phone-demo]')) {
    const s: Strings = JSON.parse(root.dataset.strings ?? '{}');
    const log = root.querySelector<HTMLElement>('.log')!;
    const talk = root.querySelector<HTMLButtonElement>('.talk')!;
    const label = root.querySelector<HTMLElement>('.talk-label')!;
    const sound = root.querySelector<HTMLButtonElement>('.sound')!;
    const canSpeak = 'speechSynthesis' in window;
    let index = 0;
    let busy = false;

    if (canSpeak) sound.hidden = false;
    sound.addEventListener('click', () => {
      const on = sound.getAttribute('aria-pressed') !== 'true';
      sound.setAttribute('aria-pressed', String(on));
      if (!on) speechSynthesis.cancel();
    });

    const bubble = (cls: string, text: string, who?: string) => {
      const p = document.createElement('p');
      p.className = cls;
      if (who) {
        const span = document.createElement('span');
        span.className = 'visually-hidden';
        span.textContent = `${who} : `;
        p.append(span);
      }
      p.append(text);
      log.append(p);
      requestAnimationFrame(() => p.classList.add('in'));
    };

    talk.addEventListener('click', async () => {
      if (busy) return;
      busy = true;
      const ex = s.exchanges[index % s.exchanges.length];
      index += 1;
      log.replaceChildren();
      root.classList.add('listening');
      label.textContent = s.listening;
      await wait(1100);
      bubble('ask', ex.ask, s.you);
      root.classList.remove('listening');
      await wait(700);
      bubble('answer', ex.answer, 'Mobilis');
      if (canSpeak && sound.getAttribute('aria-pressed') === 'true') {
        speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(ex.answer);
        u.lang = s.voiceLang;
        speechSynthesis.speak(u);
      }
      label.textContent = s.talk;
      busy = false;
    });
  }
</script>

<style>
  .demo {
    position: relative;
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }
  .halo {
    position: absolute;
    inset: 4% -6% auto;
    aspect-ratio: 1;
    max-width: 30rem;
    margin-inline: auto;
    border-radius: 50%;
    background: var(--halo);
    z-index: 0;
  }
  .phone {
    position: relative;
    z-index: 1;
    width: min(clamp(15rem, 24vw, 19rem), calc(70svh * 9 / 19));
    min-width: 15rem;
    aspect-ratio: 9 / 19;
    padding: 0.7rem;
    border-radius: 2.6rem;
    background: #0a0f1c;
    box-shadow:
      0 2px 0 1px #2a3550 inset,
      0 30px 60px -20px rgb(5 12 30 / 0.55),
      0 12px 24px -12px rgb(5 12 30 / 0.4);
  }
  .screen {
    position: relative;
    height: 100%;
    border-radius: 2rem;
    background: #fdf9f2;
    color: #1d1d1f;
    padding: 0.9rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    font-family: Roboto, system-ui, sans-serif;
  }
  .status {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #333;
  }
  .toplinks {
    display: flex;
    justify-content: space-between;
    margin-top: 1.1rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #2160c4;
  }
  .log {
    flex: 1;
    margin-top: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.35;
  }
  .log :global(p) {
    margin: 0;
  }
  .log :global(.idle) {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .log :global(.ask),
  .log :global(.answer) {
    padding: 0.55rem 0.75rem;
    border-radius: 1rem;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .log :global(.in) {
    opacity: 1;
    transform: none;
  }
  .log :global(.ask) {
    align-self: flex-end;
    max-width: 85%;
    background: #e4ecfa;
    border-bottom-right-radius: 0.3rem;
  }
  .log :global(.answer) {
    align-self: flex-start;
    max-width: 92%;
    background: #ffffff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
    border-bottom-left-radius: 0.3rem;
    font-weight: 600;
  }
  .talk-zone {
    position: relative;
    display: grid;
    place-items: center;
    margin-top: 0.5rem;
  }
  .talk {
    position: relative;
    z-index: 1;
    width: 76%;
    aspect-ratio: 1;
    border: 0;
    border-radius: 50%;
    background: #2160c4;
    color: #fff;
    font: 700 1.15rem/1.15 Roboto, system-ui, sans-serif;
    cursor: pointer;
    padding: 1rem;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .talk:hover {
    background: #1a50a8;
  }
  .talk:active {
    transform: scale(0.97);
  }
  .talk:focus-visible {
    outline: 4px solid #0a0f1c;
    outline-offset: 4px;
  }
  .ring {
    position: absolute;
    width: 76%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid #2160c4;
    opacity: 0;
  }
  .listening .ring {
    animation: ripple 1.6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  .listening .r2 {
    animation-delay: 0.35s;
  }
  .listening .r3 {
    animation-delay: 0.7s;
  }
  @keyframes ripple {
    from {
      opacity: 0.55;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.45);
    }
  }
  figcaption {
    position: relative;
    z-index: 1;
    max-width: 22rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--ink-soft);
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }
  .sound {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 1.5px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .sound[hidden] {
    display: none;
  }
  .sound[aria-pressed='false'] .wave {
    opacity: 0.25;
  }
  .sound[aria-pressed='true'] {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    color: #fff;
  }
</style>

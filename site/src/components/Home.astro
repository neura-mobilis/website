---
import Layout from '../layouts/Layout.astro';
import PhoneDemo from './PhoneDemo.astro';
import Icon from './Icon.astro';
import { routes, toLocale } from '../i18n/routes';
import { home } from '../i18n/home';
import { site } from '../data/site';

const lang = toLocale(Astro.currentLocale);
const t = home[lang];
const r = (key: keyof typeof routes) => routes[key][lang];
const jsonLd = { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.url, email: site.email, description: t.orgDescription };
---

<Layout route="home" title={t.title} description={t.description} jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="status"><span class="dot" aria-hidden="true"></span>{t.status}</p>
      <h1 id="hero-title">{t.h1}</h1>
      <p class="lead">{t.lead}</p>
      <div class="actions">
        <a class="button" href={r('tester')}>{t.ctaTester}</a>
        <a class="button secondary" href={r('mobilis')}>{t.ctaMobilis}</a>
      </div>
    </div>
    <div class="hero-demo">
      <PhoneDemo />
    </div>
  </section>

  <section class="problem" aria-labelledby="problem-title">
    <div class="section">
      <h2 id="problem-title">{t.problemTitle}</h2>
      <p class="statement">
        {t.problemBefore} <strong>{t.problemCount}</strong> {t.problemMiddle} <strong>{t.problemNew}</strong> {t.problemAfter}
      </p>
      <p class="note">{t.source}</p>
    </div>
  </section>

  <section class="section what" aria-labelledby="what-title">
    <div class="what-head">
      <h2 id="what-title">{t.whatTitle}</h2>
      <p class="lead">{t.whatLead}</p>
      <a class="more" href={r('mobilis')}>{t.whatLink}<Icon name="arrow" /></a>
    </div>
    <ul class="features">
      {
        t.features.map((f) => (
          <li>
            <span class="icon"><Icon name={f.icon} /></span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band next" aria-labelledby="next-title">
    <div class="section">
      <h2 id="next-title">{t.nextTitle}</h2>
      <ol class="timeline">
        {
          t.steps.map((step, i) => (
            <li class={i === 0 ? 'now' : undefined}>
              <span class="marker" aria-hidden="true" />
              <p class="when">{step.when}</p>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <a class="more" href={r('approach')}>{t.nextLink}<Icon name="arrow" /></a>
    </div>
  </section>

  <section class="join" aria-labelledby="join-title">
    <div class="section join-inner">
      <div>
        <h2 id="join-title">{t.joinTitle}</h2>
        <p>{t.joinText}</p>
      </div>
      <a class="big-button" href={r('tester')}><span>{t.joinButton}</span></a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    max-width: var(--wide);
    margin: 0 auto;
    padding: clamp(2.5rem, 7vw, 5.5rem) var(--gutter) clamp(3rem, 7vw, 5rem);
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
  .hero h1 {
    max-width: 14ch;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    padding: 0.35rem 0.9rem 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.95rem;
    font-weight: 700;
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #1f9d6b;
    box-shadow: 0 0 0 4px rgb(31 157 107 / 0.2);
  }
  .problem {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .statement {
    max-width: 48rem;
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    line-height: 1.4;
  }
  .statement strong {
    color: var(--accent);
    font-weight: 800;
  }
  .what {
    display: grid;
    gap: 2.5rem 4rem;
  }
  @media (min-width: 60rem) {
    .what {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .features li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .features li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .features h3 {
    margin-top: 0.2rem;
  }
  .features p {
    margin: 0;
    color: var(--ink-soft);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--accent-strong);
    color: #fff;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: 700;
  }
  .more :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.25s var(--ease);
  }
  .more:hover :global(svg) {
    transform: translateX(4px);
  }
  .timeline {
    list-style: none;
    margin: 2rem 0;
    padding: 0;
    display: grid;
    gap: 2rem;
    position: relative;
  }
  @media (min-width: 52rem) {
    .timeline {
      grid-template-columns: repeat(3, 1fr);
    }
    .timeline::before {
      content: '';
      position: absolute;
      top: 0.7rem;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(to right, var(--accent-strong) 33%, var(--line-strong) 33%);
    }
  }
  .timeline li {
    position: relative;
  }
  .marker {
    display: block;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: inset 0 0 0 2px var(--line-strong);
    position: relative;
  }
  .now .marker {
    background: var(--accent-strong);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent-strong) 25%, transparent);
  }
  .when {
    margin: 1rem 0 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent);
  }
  .timeline h3 {
    margin-top: 0.25rem;
  }
  .timeline p:last-child {
    margin: 0;
    color: var(--ink-soft);
  }
  .join {
    background: var(--band);
    color: var(--band-ink);
  }
  .join-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 52rem) {
    .join-inner {
      grid-template-columns: 1fr auto;
    }
  }
  .join p {
    font-size: 1.2rem;
    opacity: 0.92;
  }
  .join :focus-visible {
    outline-color: #fff;
  }
  .big-button {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(10rem, 22vw, 13rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent-strong);
    color: #fff;
    font-size: 1.25rem;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    padding: 1.5rem;
    box-shadow:
      0 0 0 10px rgb(255 255 255 / 0.08),
      0 0 0 22px rgb(255 255 255 / 0.05),
      0 20px 40px -10px rgb(0 0 0 / 0.45);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .big-button:hover {
    transform: scale(1.04);
    box-shadow:
      0 0 0 14px rgb(255 255 255 / 0.1),
      0 0 0 30px rgb(255 255 255 / 0.06),
      0 24px 48px -10px rgb(0 0 0 / 0.5);
  }
</style>
